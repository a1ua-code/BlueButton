# Copy this file to .env (`npm run setup` does it for you). Never commit .env.

# Matches docker-compose.yml. If you installed PostgreSQL yourself instead of using
# Docker, change user, password and port (usually 5432) to match your install.
DATABASE_URL="postgresql://bluebutton:bluebutton@localhost:5433/bluebutton?schema=public"

# Port of the API server. The React dev server (port 5173) forwards /api here.
PORT=4000

# Where the React app runs in development (used for CORS on the chat socket).
CLIENT_ORIGIN="http://localhost:5173"

# --- Filled in later by the owners of these features ---
KAKAO_REST_API_KEY=""       # B: server-only Kakao Local REST API key
# YOUTUBE_API_KEY=""         # B: rule videos (YouTube Data API v3)
# SMTP_HOST=""               # A: emails (verification, password reset)
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="B&B <no-reply@example.com>"
